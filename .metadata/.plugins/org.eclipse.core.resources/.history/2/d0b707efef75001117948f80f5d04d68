package com.rays.array;

public class TestFindNumber {
 
	public static void main(String[] args) {
		
		int[] arr = {10, 11, 13 ,17 , 88};
		
		int num = 17;
		
		int count  = 0;
		
		for(int i=0; i<arr.length; i++) {
			
			if(arr[i] == num) {
				
				count ++;
			}
		}
		
		if(count == 0) {
			
			System.out.println("Num is not exist");
			
		} else {
			
			System.out.println("Num is exist");
		}
	}
}
