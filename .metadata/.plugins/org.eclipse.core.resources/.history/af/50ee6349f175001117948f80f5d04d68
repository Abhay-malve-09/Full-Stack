package com.rays.array;

public class TestCharArray {

	public static void main(String[] args) {
		
		char[] c = {'a', 'b', 'c', 'd'};
		
		System.out.println(c[0]);
		System.out.println("----------------");
		
		for(int i=0; i<c.lenth; i++) {
			
			System.out.println(i + "=" + c[i]);
			System.out.println("---------------");
		
		}
	}
	
	for(char e : c) {
		System.out.println(e);
	}
}
