package com.rays.oop.polymorphism.bank;

public class TestBankByArr {

	public static void main(String[] args) {
		
		Bank[] b = new Bank[2];
		
		b[0] = new AxisBank();
		b[1] = new IciciBank();
		
		AxisBank a = (AxisBank) b[0];
		
		System.out.println("Name: " + a.getName());
		System.out.println("InterestRate: " + a.getInterestRate());
		
		System.out.println("----------------------------");
		
		IciciBank i = (IciciBank) b[1];
		
		System.out.println("Name: " + i.getName());
		System.out.println("InterestRate: " + i.getInterestRate());
	}
}
