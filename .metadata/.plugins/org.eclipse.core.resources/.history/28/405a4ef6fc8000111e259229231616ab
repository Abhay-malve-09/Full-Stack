package com.rays.oop.polymorphism.shapeWithReturnType;

public class TestShape {
	
	public static void main(String[] args) {
		
		Shape[] s = new Shape[3];
		
		s[0] = Shape.getShape(1);
		s[1] = Shape.getShape(2);
		s[2] = Shape.getShape(3);
		
		Circle c = (Circle) s[0];
		
		c.setRadius(4);
		
		
		System.out.println("-------------------------");
		
		Rectangle r = (Rectangle) s[1];
		
		r.setLength(2);
		r.setWidth(5);
		 
		System.out.println("--------------------------");
		 
		Traingle t = (Traingle) s[2];
		
		t.setBase(2);
		t.setHeight(6);

		
		for(int i = 0; i<s.length; i++) {
			s[i].area();
		}
	}

}
