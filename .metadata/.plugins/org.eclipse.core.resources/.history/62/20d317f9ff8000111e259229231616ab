package com.rays.oop.polymorphism.BankWithReturnType;

public class Bank {

	public String getName() {
		return "RBI BANK";
	}
	
	public double interestRate() {
		return 10.0;
	}
	
	public static Bank getBank(double i) {
		
		if(i == 1) 
			return new  AxisBank();
		
		if(i == 2) 
			return new IciciBank();
		
		if(i == 3)
			return new SbiBank();
	}
	
}
